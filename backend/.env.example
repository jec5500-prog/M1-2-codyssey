# backend/.env.example
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (cp .env.example .env)

# [필수] OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# [필수] Firebase 서비스 계정 키 (JSON 문자열 또는 Base64 중 하나)
#   Base64 생성: Linux  -> base64 -w0 serviceAccountKey.json
#                macOS  -> base64 -i serviceAccountKey.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_JSON=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50IiwuLi59

# [필수] 허용할 프론트엔드 Origin (쉼표로 구분, 끝에 / 붙이지 않기)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://your-app.vercel.app

# [선택] Vercel 프리뷰 배포까지 허용하고 싶을 때 (정규식)
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# [선택] 로그 레벨
LOG_LEVEL=INFO